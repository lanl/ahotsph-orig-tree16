ifeq ($(PAROS),mpi)
  LOADLIBES:=-L$(MPIHOME)/lib64 -lmpi -lsvml
  PAROSCFLAGS:=-I$(MPIHOME)/include
endif


LDFLAGS = -L${TREEHOME}/Objfiles/${ARCH}
LDLIBS = -ltree -lsw -lm

PROGS = interp_cylgrid interp_cylgrid.${PAROS}

.PHONY: all clean

all: ${PROGS}

clean: 
	-${RM} *.o ${PROGS}

