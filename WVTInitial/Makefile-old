ifeq ($(ARCH),p4icc)
    CC:=/ss1-raid/opt/intel/compiler71/compiler70/ia32/bin/icc
    CFLAGS = -g -Wall -DLONG_LONG_KEYS -march=pentium4 -mcpu=pentium4\
	-I${TREEHOME}/include -D__iX86__=686 -DUSE_SYSTEM_MALLOC -align -Zp8
endif

ifeq ($(ARCH),p4icc-coyote)
    CFLAGS = -g -Wall -D__iX86=686 -DLONG_LONG_KEYS \
	-I${TREEHOME}/include
endif

ifeq ($(ARCH),i686)
    CC:=/usr/bin/gcc
    CFLAGS = -g -Wall -DLONG_LONG_KEYS \
	-I${TREEHOME}/include -D__iX86__=686 -DUSE_SYSTEM_MALLOC -malign-double
endif

ifeq ($(ARCH),macbook)
    CC:=/usr/bin/gcc
    CFLAGS = -g -Wall -DLONG_LONG_KEYS \
        -I${TREEHOME}/include -D__iX86__=686 -DUSE_SYSTEM_MALLOC
endif

ifeq ($(ARCH),infinity)
    CC:=/usr/bin/gcc
    CFLAGS = -g -Wall -DLONG_LONG_KEYS \
        -I${TREEHOME}/include -D__iX86__=686 -DUSE_SYSTEM_MALLOC
endif

