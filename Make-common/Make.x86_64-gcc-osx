defaultCC:=gcc
defaultFC:=gfortran

CC_SPECIFIC:=-DLONG_LONG_KEYS \
            -fgnu89-inline \
            -Wno-deprecated \
            -Wno-deprecated-declarations \
            -Wno-incompatible-pointer-types \
            -Wno-int-to-pointer-cast \
            -Wno-pointer-to-int-cast \
            -Wno-int-conversion
C_OPTIMIZE:=-O3
FC_SPECIFIC:=-ff2c \
            -fno-align-commons
F_OPTIMIZE:=-O0
ARCH_SPECIFIC:=-DUSE_SYSTEM_MALLOC \
            -D_FILE_OFFSET_BITS=64 \
            -DYY_SKIP_YYWRAP \
            -fno-common
##override OPTIMIZE:=-O3 -static
override AGGRESSIVE_OPT=
LOADLIBES:=-Bstatic -lm
LEX:=flex
YACC:=bison -y
RANLIB:=ranlib

include $(treedir)/Make-common/Make.default

swsrc:=lsv.c swampi.c

ifeq ($(PAROS),mpi)
LOADLIBES:=-lmpi -lm
PAROSCFLAGS:=
endif
